{
  "name": "hwb",
  "version": "0.2.0",
  "description": "hwb (harness workbench) — 面向 dsh home 的数据平面工作台：跨实例聚合项目 / 会话 / Token 用量，并托管本机与远程 dsh web（控制平面）",
  "type": "module",
  "bin": {
    "hwb": "src/cli.js"
  },
  "files": [
    "src",
    "scripts",
    "images",
    "docs",
    "dsh-remote-index",
    "dsh-static-cache",
    "dsh-hwb-open-session",
    "tests",
    "README.md",
    "CHANGELOG.md",
    "DSH_Workbench_Fusion_Architecture.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "workbench",
    "dashboard",
    "sqlite",
    "data-plane",
    "agent"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js tests/compat/*.test.js",
    "test:unit": "node --test tests/*.test.js",
    "test:compat": "node --test tests/compat/*.test.js",
    "compat": "node scripts/compat-check.mjs"
  },
  "author": "hwb contributors",
  "license": "MIT"
}
